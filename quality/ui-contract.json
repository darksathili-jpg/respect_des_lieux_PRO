{
  "schemaVersion": 5,
  "application": "Respect des Lieux PRO",
  "shell": {
    "id": "app-shell",
    "exactlyOne": true,
    "mainRegionId": "main-region"
  },
  "navigation": [
    { "view": "dashboard", "label": "Accueil" },
    { "view": "signalements", "label": "Signalements" },
    { "view": "reparations", "label": "Réparations" },
    { "view": "sauvegardes", "label": "Sauvegardes" },
    { "view": "confidentialite", "label": "Protection des données" },
    { "view": "systeme", "label": "Système local" }
  ],
  "forbiddenNavigationLabels": [
    "Interventions",
    "Suivi",
    "Établissement",
    "Paramètres"
  ],
  "forbiddenProductionPersona": [
    "Mme Dupont",
    "Personnel",
    "Mardi 15 avril 2025",
    "14 °C"
  ],
  "requiredViews": [
    "view-dashboard",
    "view-signalements",
    "view-reparations",
    "view-sauvegardes",
    "view-confidentialite",
    "view-systeme"
  ],
  "requiredControls": [
    "privacy-toggle",
    "backup-now",
    "new-signalement",
    "signal-search",
    "backup-view-action",
    "open-backups",
    "encrypted-backup",
    "encrypted-restore",
    "rights-export",
    "open-exports",
    "open-data"
  ],
  "designSystem": {
    "version": "r4-p3a",
    "entrypoint": "renderer/styles.css",
    "layers": [
      "renderer/tokens.css",
      "renderer/components.css",
      "renderer/layout.css",
      "renderer/home.css"
    ],
    "requiredAssets": [
      "renderer/assets/watteau-sidebar-mark.svg",
      "renderer/assets/watteau-home-hero.svg"
    ],
    "requiredTokens": [
      "--rdl-ds-ready",
      "--rdl-font-sans",
      "--rdl-canvas",
      "--rdl-surface",
      "--rdl-text-strong",
      "--rdl-blue-700",
      "--rdl-space-4",
      "--rdl-radius-lg",
      "--rdl-shadow-md",
      "--rdl-focus",
      "--watteau-navy",
      "--watteau-brick",
      "--watteau-cream"
    ]
  },
  "visualIdentity": {
    "homeHeadline": "Bonjour !",
    "homeLead": "Ensemble, prenons soin de notre lycée.",
    "localStorageMessage": "Données stockées localement",
    "sidebarMotto": "Des lieux respectés pour mieux apprendre",
    "forbiddenHomeHeadline": "Les données restent sur ce PC."
  },
  "forbiddenRuntimeFiles": [
    "renderer/dashboard-vf.css"
  ],
  "forbiddenRuntimeTokens": [
    "vf-dashboard",
    "visual-test-mode",
    "RDL_VISUAL_TEST",
    "dashboard-master.png"
  ],
  "productionRules": {
    "singleShellRequired": true,
    "alternateUiForQualificationForbidden": true,
    "masterScreenshotInRuntimeForbidden": true,
    "navigationAndViewsMustMatch": true,
    "allViewsMustUseHiddenState": true,
    "designSystemLayeringRequired": true,
    "productionAssetsRequired": true,
    "focusVisibleRequired": true,
    "reducedMotionRequired": true,
    "responsiveFallbackRequired": true,
    "homeUsesRealDataOnly": true,
    "homeMustNotExposeLocalPath": true,
    "detailDialogRequiresStableScrollbar": true,
    "detailDialogRequiresSingleColumnFallback": true,
    "detailDialogRequiresMultipleExitPaths": true,
    "releaseMustRunQualityGate": true,
    "releaseMustRunPackagedInteractionGate": true
  }
}
