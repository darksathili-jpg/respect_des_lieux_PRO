{
  "name": "respect-des-lieux-pro",
  "version": "5.2.0-alpha.3",
  "private": true,
  "description": "Application desktop locale de suivi des dégradations en établissement scolaire — données stockées uniquement sur le poste utilisateur.",
  "main": "main-bootstrap.cjs",
  "author": "Lycée Watteau",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "start": "electron .",
    "check": "node --check main-bootstrap.cjs && node --check main.cjs && node --check preload.cjs && node --check src/database.cjs && node --check src/storage.cjs && node --check src/portable-backup.cjs && node --check renderer/app.js",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm test",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.4.0",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "fr.lycee-watteau.respect-des-lieux-pro",
    "productName": "Respect des Lieux PRO",
    "artifactName": "Respect-des-Lieux-PRO-${version}-${arch}.${ext}",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "files": [
      "main-bootstrap.cjs",
      "main.cjs",
      "preload.cjs",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
